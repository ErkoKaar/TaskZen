NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the client. Used to resolve username -> email at login.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to 1 to build the public demo instead: no auth, no Supabase, sample data
# kept in the visitor's browser. The variables above are then not needed.
# NEXT_PUBLIC_DEMO_MODE=1
